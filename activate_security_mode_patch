import os
import re

PKG_DIR = "app/src/main/java/com/zevorix/assistant"
MAIN_VM = PKG_DIR + "/viewmodel/MainViewModel.kt"
MAIN_SCREEN = PKG_DIR + "/ui/MainScreen.kt"

print(">> Activating existing Security Mode stub...")

# 1) البحث عن متغير وضع الحماية في MainViewModel وتفعيله
if os.path.exists(MAIN_VM):
    with open(MAIN_VM, "r", encoding="utf-8") as f:
        vm_code = f.read()

    # حماية من التكرار
    if "SecurityMonitor.startMonitoring" not in vm_code:
        # سنبحث عن الدالة التي تُفعل وضع الحماية (غالباً تسمى toggleSecurityMode أو setSecurityMode)
        # إذا لم نجدها، سنضيف دالة جديدة ونربطها بالـ UI لاحقاً
        security_function = """
    // 🛡️ تفعيل وضع الحماية الحقيقي
    fun toggleSecurityMode(enabled: Boolean) {
        if (enabled) {
            com.zevorix.assistant.security.SecurityMonitor.startMonitoring(getApplication())
            _uiState.update { it.copy(partialText = "تم تفعيل وضع الحماية 🛡️") }
        } else {
            _uiState.update { it.copy(partialText = "تم إيقاف وضع الحماية ⚠️") }
        }
    }
"""
        # حقن الدالة قبل آخر قوس إغلاق للكلاس
        vm_code = vm_code.rsplit('}', 1)[0] + security_function + '\n}'
        with open(MAIN_VM, "w", encoding="utf-8", newline="\n") as f:
            f.write(vm_code)
        print(">> Injected Security Mode logic into MainViewModel")

# 2) ربط زر "وضع الحماية" في MainScreen ليفتح مركز الأمان أو يفعّل الحماية
if os.path.exists(MAIN_SCREEN):
    with open(MAIN_SCREEN, "r", encoding="utf-8") as f:
        screen_code = f.read()

    # إذا كان الزر موجوداً بالفعل ولكنه لا يفعل شيئاً، سنربطه بمركز الأمان
    # سنبحث عن أي شيء يحتوي على "وضع الحماية" أو "Security Mode"
    if "SecurityCenterActivity" not in screen_code:
        # سنقوم بإضافة زر في القائمة الجانبية يفتح مركز الأمان
        pass # (تمت إضافته عبر menu_items_patch.py مسبقاً)

print(">> Security Mode Activated successfully!")